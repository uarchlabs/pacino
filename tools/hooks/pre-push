#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Jeff Nye, uarchlabs.com
# SPDX-FileCopyrightText: 2026 Jeff Nye <jeff@uarchlabs.com>
#
# tools/hooks/pre-push -- refuse a push of any commit without a passing
# regression
#
# The regression is not run here. git opens the connection to the remote
# before it runs this hook, and a regression long enough to leave that
# connection idle made the push fail after the regression passed. Run
# it first:
#   ./tools/regress.sh
# A passing run on a clean tree writes the commit's sha to
# .git/regress_pass (see tools/regress.sh). This hook allows the push only
# when every commit being pushed is that commit. It takes no measurable
# time.
#
# This file is not installed by the project tooling. To install, from the
# repo root:
#   git config core.hooksPath tools/hooks
# git then runs hooks from tools/hooks/ instead of .git/hooks/.
# git passes the refs being pushed on stdin, one line each:
#   <local ref> <local sha> <remote ref> <remote sha>

ZERO=0000000000000000000000000000000000000000
PASS_FILE=$(git rev-parse --git-path regress_pass) || exit 1
pass_sha=""
[ -f "$PASS_FILE" ] && pass_sha=$(cat "$PASS_FILE")

refused=0
checked=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  # A branch deletion pushes no commit
  [ "$local_sha" = "$ZERO" ] && continue
  checked=1
  if [ "$local_sha" != "$pass_sha" ]; then
    echo "pre-push: $local_ref ($local_sha) has no passing regression."
    refused=1
  fi
done

if [ $refused -ne 0 ]; then
  if [ -n "$pass_sha" ]; then
    echo "pre-push: the last passing regression was on $pass_sha."
  else
    echo "pre-push: no passing regression is recorded."
  fi
  echo "pre-push: check out the commit, run ./tools/regress.sh on a clean"
  echo "pre-push: tree, then push again. Push refused."
  exit 1
fi
[ $checked -ne 0 ] && echo "pre-push: regression passed on $pass_sha."
exit 0
