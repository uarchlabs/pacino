# Makefile -- L1I interface parameter agreement check (BP-115)
#
# l1i_param_chk compares the L1I parameters of bp_defines_pkg with
# the generated l1i_pkg at elaboration (TD#122 / TD-IF-1). It is
# lint only: there is no logic, so there is no sim and no testbench.
#
# TARGETS.
#
#   lint      the check at the shipped values. Passes when the two
#             packages agree.
#   lint_neg  the check with PA_WIDTH overridden to 32. Passes ONLY
#             when verilator FAILS and its output carries the
#             PA_WIDTH mismatch message. A check that has never been
#             seen to fail proves nothing; this target is that proof,
#             every run.
include $(RVA_ROOT)/rtl/Vars.mk

ifeq ($(VERBOSE),1)
  Q        :=
  VSILENCE :=
else
  Q        := @
  VSILENCE := > /dev/null
  MAKEFLAGS := -s --no-print-directory
endif

.DEFAULT_GOAL := all

RTL_DIR  := rtl
BPU_DIR  := ../bpu/rtl
# l1i_pkg is GENERATED by cachegen and lives in the tools/cachegen
# submodule. It is read here and never edited. import/l1i/ holds an
# older 32-bit emission and must not be used.
L1I_DIR  := $(RVA_ROOT)/tools/cachegen/output/l1i/rtl
VER_OUT  := obj

VER_FLAGS := --sv -Wall -Wno-UNUSED -Wno-IMPORTSTAR --timing

# bp_structs_pkg is not listed: the check reads bp_defines_pkg only.
CHK_SRCS := \
  $(BPU_DIR)/bp_defines_pkg.sv \
  $(L1I_DIR)/l1i_pkg.sv \
  $(RTL_DIR)/l1i_param_chk.sv

# lint_neg. The override and the message it must produce. The
# message text is the one l1i_param_chk.sv prints for PA_WIDTH.
NEG_OVERRIDE := -GPA_WIDTH=32
NEG_MSG      := PA_WIDTH = 32 differs from l1i_pkg::L1iPaBits = 36
NEG_DIR      := $(VER_OUT)_lint_neg
NEG_LOG      := $(NEG_DIR)/verilator.log

.PHONY: all clean lint lint_neg

all: lint lint_neg

lint:
	@echo "[linting]    l1i_param_chk"
	$(Q)$(VERILATOR) --lint-only $(VER_FLAGS) \
	  --top-module l1i_param_chk \
	  $(CHK_SRCS) $(VSILENCE)

# Verilator's output goes to $(NEG_LOG) and is not echoed, so a
# passing run leaves no %Warning or %Error in this target's own log.
# On a fail the log path is printed for inspection.
lint_neg:
	@echo "[linting]    l1i_param_chk $(NEG_OVERRIDE), must fail"
	$(Q)mkdir -p $(NEG_DIR)
	$(Q)if $(VERILATOR) --lint-only $(VER_FLAGS) $(NEG_OVERRIDE) \
	      --top-module l1i_param_chk \
	      $(CHK_SRCS) > $(NEG_LOG) 2>&1; then \
	  echo "lint_neg: FAIL - verilator exited 0, see $(NEG_LOG)"; \
	  exit 1; \
	elif grep -qF '$(NEG_MSG)' $(NEG_LOG); then \
	  echo "lint_neg: PASS - mismatch rejected with the PA_WIDTH message"; \
	else \
	  echo "lint_neg: FAIL - no PA_WIDTH message, see $(NEG_LOG)"; \
	  exit 1; \
	fi

clean:
	@echo "[cleaning]   l1i_param_chk"
	$(Q)rm -rf $(VER_OUT)*

# -- Regression plumbing (TOOLS-006) ----------------------------------
# tools/regress.sh runs every REGRESS_TARGETS entry with its own make
# call and fails if a target defined in this file is in neither list.
# Exclusions:
#   all                 - aggregate.
#   clean, regress_list - housekeeping and this plumbing.
REGRESS_TARGETS := lint lint_neg
REGRESS_EXCLUDE := all clean regress_list

.PHONY: regress_list
regress_list:
	@echo "test: $(REGRESS_TARGETS)"
	@echo "exclude: $(REGRESS_EXCLUDE)"
